# DonWeb worker public port
PORT=8787
NODE_ENV=production

# Supabase project
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Shared secret between Supabase Edge Functions and DonWeb worker
MAPADATA_WORKER_SECRET=CHANGE_ME_64_CHARS

# Google Places API official key
GOOGLE_PLACES_API_KEY=YOUR_GOOGLE_PLACES_API_KEY

# Worker behavior
WORKER_ID=donweb-worker-1
MAPADATA_PLACES_MODE=basic
MAPADATA_DEFAULT_LIMIT=20
MAPADATA_MAX_LIMIT=500
MAPADATA_STORAGE_BUCKET=mapadata-exports
MAPADATA_POLL_BATCH_SIZE=1
MAPADATA_HEARTBEAT_STALE_MINUTES=10
